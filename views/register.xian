{{> head}}
<body class="auth-body">
  <main class="auth-layout">
    <section class="auth-aside">
      <a class="brand brand-light" href="/"><span class="brand-mark">S</span><span class="brand-copy"><strong>StockTrack</strong><small>Grocery inventory</small></span></a>
      <div class="auth-message"><span class="auth-kicker">A FRESH WAY TO MANAGE STOCK</span><h1>Less guesswork.<br>More fresh.</h1><p>Bring your products, stock movement, and expiry reminders together in one simple workspace.</p><div class="auth-illustration"><span class="illustration-bag">▧</span><span class="illustration-leaf">✳</span><span class="illustration-line"></span><span class="illustration-caption">Stock smarter, waste less.</span></div></div>
      <span class="auth-aside-footer">Grocery inventory management</span>
    </section>
    <section class="auth-main">
      <div class="auth-form-wrap">
        <div class="auth-mobile-brand"><span class="brand-mark">S</span><strong>StockTrack</strong></div>
        <p class="eyebrow">GET STARTED</p><h2>Create your account</h2><p class="auth-subtitle">Set up your store’s inventory workspace.</p>
        {{#each error_msg}}<div class="notice notice-error" role="alert">{{this}}</div>{{/each}}
        <form class="auth-form" method="POST" action="/register">
          <label class="form-field">Your name<input type="text" name="name" maxlength="120" placeholder="Store manager" autocomplete="name" required></label>
          <label class="form-field">Email address<input type="email" name="email" placeholder="you@store.com" autocomplete="email" required></label>
          <label class="form-field">Password<input type="password" name="password" minlength="8" placeholder="At least 8 characters" autocomplete="new-password" required></label>
          <button class="button button-primary auth-submit" type="submit">Create account <span>→</span></button>
        </form>
        <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
      </div>
      <footer class="auth-legal">StockTrack · Simple, reliable grocery stock monitoring</footer>
    </section>
  </main>
{{> footer}}
