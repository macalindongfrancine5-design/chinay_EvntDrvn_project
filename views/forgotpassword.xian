{{> head}}
<body class="auth-body">
  <main class="auth-layout">
    <section class="auth-aside">
      <a class="brand brand-light" href="/"><span class="brand-mark">S</span><span class="brand-copy"><strong>StockTrack</strong><small>Grocery inventory</small></span></a>
      <div class="auth-message"><span class="auth-kicker">STOCKTRACK ACCOUNT</span><h1>Back to<br>business.</h1><p>Keep your grocery inventory organized, visible, and ready for the day.</p></div>
      <span class="auth-aside-footer">Grocery inventory management</span>
    </section>
    <section class="auth-main">
      <div class="auth-form-wrap"><p class="eyebrow">ACCOUNT SUPPORT</p><h2>Password recovery</h2><p class="auth-subtitle">Password reset is not configured yet. Contact your StockTrack administrator for help accessing your account.</p><a class="button button-primary auth-submit" href="/login">Back to sign in <span>→</span></a></div>
      <footer class="auth-legal">StockTrack · Simple, reliable grocery stock monitoring</footer>
    </section>
  </main>
{{> footer}}
