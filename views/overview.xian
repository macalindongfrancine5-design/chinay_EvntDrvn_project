{{> head}}
<body class="app-body">
  <div class="app-shell simple-app">
    {{> sidebar}}
    <main class="main-content">
      <header class="topbar">
        <button class="mobile-menu" type="button" data-menu-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">☰</button>
        <div class="breadcrumb">Workspace <span>/</span><strong>Dashboard</strong></div>
        <div class="topbar-right">
          <span class="today-label">{{displayName}}</span>
          <span class="topbar-avatar" aria-hidden="true">S</span>
        </div>
      </header>
      <div class="simple-content">
        {{#each success_msg}}<div class="notice notice-success" role="status">{{this}}<button type="button" aria-label="Dismiss" data-dismiss>×</button></div>{{/each}}
        {{#each error_msg}}<div class="notice notice-error" role="alert">{{this}}<button type="button" aria-label="Dismiss" data-dismiss>×</button></div>{{/each}}

        <section class="simple-heading">
          <div><h1>Dashboard</h1><p>Your store inventory at a glance.</p></div>
          <a class="button button-primary" href="/inventory">View inventory <span aria-hidden="true">→</span></a>
        </section>

        <section class="metric-grid overview-metrics" aria-label="Inventory summary">
          <div class="metric-card"><div class="metric-top"><span class="metric-label">Active products</span><span class="metric-icon icon-green" aria-hidden="true">▤</span></div><strong class="metric-value">{{totalProducts}}</strong><span class="metric-caption">Products currently tracked</span></div>
          <div class="metric-card"><div class="metric-top"><span class="metric-label">Low stock</span><span class="metric-icon icon-amber" aria-hidden="true">!</span></div><strong class="metric-value">{{lowStockCount}}</strong><span class="metric-caption">At or below reorder level</span></div>
          <div class="metric-card"><div class="metric-top"><span class="metric-label">Out of stock</span><span class="metric-icon icon-red" aria-hidden="true">−</span></div><strong class="metric-value">{{outOfStockCount}}</strong><span class="metric-caption">Items with no quantity left</span></div>
          <div class="metric-card"><div class="metric-top"><span class="metric-label">Stock movements</span><span class="metric-icon icon-blue" aria-hidden="true">↕</span></div><strong class="metric-value">{{movementCount}}</strong><span class="metric-caption">Recorded stock changes</span></div>
        </section>

        <section class="panel overview-activity">
          <div class="panel-heading">
            <div><h2>Recent stock activity</h2><p>The latest changes recorded for your inventory.</p></div>
            <a class="text-link" href="/inventory">View inventory <span>→</span></a>
          </div>
          {{#if hasRecentMovements}}
          <div class="table-wrap">
            <table>
              <thead><tr><th>ACTIVITY</th><th>PRODUCT</th><th>QUANTITY</th><th>DATE</th></tr></thead>
              <tbody>
                {{#each recentMovements}}
                <tr>
                  <td><strong>{{movementLabel}}</strong></td>
                  <td>{{Product.name}}</td>
                  <td>{{quantityDisplay}}</td>
                  <td>{{dateDisplay}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{else}}
          <div class="empty-state"><strong>No stock activity yet</strong><p>Stock changes will appear here as inventory is updated.</p></div>
          {{/if}}
        </section>
        <footer class="simple-footer">StockTrack · Grocery inventory</footer>
      </div>
    </main>
  </div>
{{> footer}}
